# Create .gitignore file
@"
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Application specific - EXCLUDE THESE
chroma_db/
uploads/
uploaded_documents/

# Environment variables - EXCLUDE SECRETS
.env
.env.local
.secrets/

# Logs
*.log
logs/

# Temporary files
temp/
tmp/
"@ | Out-File -FilePath ".gitignore" -Encoding utf8